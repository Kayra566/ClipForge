# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js, React, and TypeScript output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Test and tooling output
coverage/
.nyc_output/
.turbo/
.cache/
.eslintcache
playwright-report/
test-results/

# Logs and process files
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem

# Local video uploads, renders, and processing artifacts
uploads/*
!uploads/.gitkeep
renders/*
!renders/.gitkeep
output/*
!output/.gitkeep
outputs/*
!outputs/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
public/outputs/*
!public/outputs/.gitkeep
tmp/
temp/
.ffmpeg/

# Generated subtitle and audio intermediates
*.ass
*.srt
*.vtt
*.wav
*.pcm
!tests/fixtures/**/*.ass
!tests/fixtures/**/*.srt
!tests/fixtures/**/*.vtt
!tests/fixtures/**/*.wav

# Local speech-to-text models and caches
models/
.whisper/
.faster-whisper/

# Optional Python speech-recognition tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Hosting and deployment state
.vercel/

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
